# URL publique du site (sans slash final). Utilisée pour le sitemap, robots.txt, canonical et Open Graph.
# Exemple : https://sausset-reuni.fr
VITE_SITE_URL=https://saussetreuni.fr

# Google Analytics 4 — ID de mesure (format G-XXXXXXXXXX). Optionnel ; si absent, aucun script GA4 n’est chargé.
# Le script n'est chargé qu’après acceptation des cookies (bandeau).
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
